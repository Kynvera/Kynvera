# Recipient used by the FormSubmit contact form.
# Copy this file to .env and replace the placeholder with the real inbox.
VITE_CONTACT_EMAIL=arpanminecraft085@gmail.com

# Optional: use a newsletter provider POST endpoint.
VITE_NEWSLETTER_ENDPOINT=

# Or provide a Substack publication URL, for example https://kynvera.substack.com.
VITE_SUBSTACK_URL=

# Optional Fathom Analytics site ID. Leave empty to disable analytics.
VITE_FATHOM_SITE_ID=
